# Copy to .env (which is gitignored) and fill in.
#
# The DfT Bus Open Data Service API key.  Free from
# https://data.bus-data.dft.gov.uk/ -- create an account, then "API key".
#
# Used by scripts/fetch_bods_gtfs.py to fetch the national bus data.  MoveIn
# serves no request with it: the app itself never needs a key.
MOVEIN_BODS_API_KEY=
